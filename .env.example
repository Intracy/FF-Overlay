# Öffentliche Adresse, unter der Dashboard und Overlay erreichbar sind (ohne Slash am Ende).
# Muss exakt so auch als OAuth-Redirect in der Twitch-App stehen: <PUBLIC_URL>/auth/twitch/callback
# Entwicklung mit „npm run dev“: http://localhost:5173 (Vite leitet /api, /ws, /auth weiter)
PUBLIC_URL=http://localhost:3000
PORT=3000

# Anmeldung über das Portal von FrankenFinals Broadcast (empfohlen). Das Portal öffnet die Overlay Engine über
# seine Kachel mit einer signierten Eintrittskarte und der Rolle der Person (Operator, Editor, Overlay-Admin).
# PORTAL_SSO_SECRET muss im Portal identisch als OVERLAY_SSO_SECRET stehen (mind. 32 Zeichen: openssl rand -hex 32).
PORTAL_URL=
PORTAL_SSO_SECRET=
# Wie lange eine Anmeldung über das Portal gilt (Stunden)
PORTAL_SESSION_HOURS=12

# Passwort fürs Dashboard. Mit Portal-Anmeldung nur noch Notfall-Zugang (volle Rechte), sonst der normale Login.
# Leer und ohne Portal = kein Login (nur im lokalen Netz sinnvoll).
ADMIN_PASSWORD=
# Pflicht in Produktion: mind. 32 zufällige Zeichen, z. B.: openssl rand -hex 32
APP_SECRET=

# Twitch-App: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# YouTube: Google-Client „Fernseher und Geräte mit begrenzter Eingabe“ (oder im Dashboard eintragen)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_CHAT_POLL_SECONDS=8

# GIPHY-Key: https://developers.giphy.com/dashboard/ (Beta-Key: 100 Aufrufe/Stunde)
GIPHY_API_KEY=

# Optional
BETTERPLACE_POLL_SECONDS=20
EVENT_RETENTION_DAYS=30
LOG_LEVEL=info
