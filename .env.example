# Öffentliche Adresse, unter der Dashboard und Overlay erreichbar sind (ohne Slash am Ende).
# Muss exakt so auch als OAuth-Redirect in der Twitch-App stehen: <PUBLIC_URL>/auth/twitch/callback
# Entwicklung mit „npm run dev“: http://localhost:5173 (Vite leitet /api, /ws, /auth weiter)
PUBLIC_URL=http://localhost:3000
PORT=3000

# Pflicht in Produktion
ADMIN_PASSWORD=bitte-aendern
# Mind. 32 zufällige Zeichen, z. B.: openssl rand -hex 32
APP_SECRET=

# Twitch-App: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# GIPHY-Key: https://developers.giphy.com/dashboard/ (Beta-Key: 100 Aufrufe/Stunde)
GIPHY_API_KEY=

# Optional
BETTERPLACE_POLL_SECONDS=20
EVENT_RETENTION_DAYS=30
LOG_LEVEL=info
